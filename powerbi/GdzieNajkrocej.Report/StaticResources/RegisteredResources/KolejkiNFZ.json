{
  "name": "KolejkiNFZ",
  "dataColors": [
    "#0E7C86",
    "#E9A23B",
    "#3B5BA9",
    "#C8553D",
    "#5E9C76",
    "#8E6C8A",
    "#2E4057",
    "#B5838D",
    "#00798C",
    "#9AA5B1",
    "#D4A373",
    "#6D597A"
  ],
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F2F4F7",
  "backgroundNeutral": "#E3E7ED",
  "tableAccent": "#0E7C86",
  "accent": "#0E7C86",
  "hyperlink": "#0E7C86",
  "visitedHyperlink": "#0B5F66",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#C8553D",
  "minimum": "#FCEFD9",
  "center": "#EE9B54",
  "maximum": "#8C2D12",
  "null": "#E6E9EE",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#374151"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F7"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "shapeMap": {
      "*": {
        "defaultColors": [
          {
            "defaultShow": true,
            "defaultColor": {
              "solid": {
                "color": "#E6E9EE"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "borderThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "BottomCenter"
          }
        ],
        "zoom": [
          {
            "autoZoom": true,
            "selectionZoom": false,
            "manualZoom": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F7F8FA"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F7F8FA"
              }
            }
          }
        ]
      }
    }
  }
}