	/// FAŁSZ dla kolejki bez pacjentów: 0 oczekujących i 0 obsłużonych w ostatnim miesiącu. NFZ podaje dla nich PCUŚ 0 dni, więc miary porównawcze (mediany, mapa, rankingi) je pomijają.
	column KolejkaAktywna
		dataType: boolean
		isHidden
		lineageTag: e2fb5cbc-9855-4add-9e14-0db6a2cdd2d7
		summarizeBy: none
		sourceColumn: KolejkaAktywna

		annotation SummarizationSetBy = Automatic

	partition FactKolejki = m
		mode: import
		queryGroup: Dane
		source =
				let
				    Prefiks = GitHubWlasciciel & "/" & GitHubRepozytorium & "/" & GitHubGalaz & "/",
				    Pobierz = (sciezka as text) as nullable binary =>
				        let
				            Odpowiedz = Web.Contents(
				                "https://raw.githubusercontent.com",
				                [RelativePath = Prefiks & sciezka, ManualStatusHandling = {404}]
				            ),
				            Status = Value.Metadata(Odpowiedz)[Response.Status],
				            Tresc =
				                if Status = 404 then null
				                else if Text.EndsWith(sciezka, ".gz") then Binary.Decompress(Odpowiedz, Compression.GZip)
				                else Odpowiedz
				        in
				            Tresc,
				    CzytajCsv = (sciezka as text, kolumny as list) as table =>
				        let
				            Plik = Pobierz(sciezka),
				            Surowa =
				                if Plik = null then #table(kolumny, {})
				                else Table.PromoteHeaders(
				                    Csv.Document(Plik, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]
				                )
				        in
				            Table.SelectColumns(Surowa, kolumny, MissingField.UseNull),
				    KolumnyFaktu = {
				        "DataSnapshotu", "MiejsceKey", "SwiadczenieKey", "Przypadek", "Oddzial", "WieleMiejsc", "WCeR",
				        "Znieczulenie", "PrzedzialWieku", "Oczekujacy", "Skresleni", "SredniCzasDni", "OkresStatystyk",
				        "PCUS", "PCUSDni", "PCUSStanNa", "PierwszyTermin", "PrognozaNFZDni"
				    },
				    Manifest = CzytajCsv("data/nfz/manifest.csv", {"DataSnapshotu", "Plik"}),
				    Pliki = List.Select(Manifest[Plik], each _ <> null and _ <> ""),
				    Snapshoty = List.Transform(Pliki, each CzytajCsv(_, KolumnyFaktu)),
				    Polaczone = Table.Combine({#table(KolumnyFaktu, {})} & Snapshoty),
				    BezPustych = Table.ReplaceValue(
				        Polaczone, "", null, Replacer.ReplaceValue,
				        {"Znieczulenie", "PrzedzialWieku", "Oczekujacy", "Skresleni", "SredniCzasDni", "OkresStatystyk",
				         "PCUS", "PCUSDni", "PCUSStanNa", "PierwszyTermin", "PrognozaNFZDni"}
				    ),
				    Typy = Table.TransformColumnTypes(
				        BezPustych,
				        {
				            {"DataSnapshotu", type date}, {"MiejsceKey", type text}, {"SwiadczenieKey", type text},
				            {"Przypadek", type text}, {"Oddzial", type text}, {"WieleMiejsc", type text}, {"WCeR", type text},
				            {"Znieczulenie", type text}, {"PrzedzialWieku", type text}, {"Oczekujacy", Int64.Type},
				            {"Skresleni", Int64.Type}, {"SredniCzasDni", Int64.Type}, {"OkresStatystyk", type text},
				            {"PCUS", type text}, {"PCUSDni", Int64.Type}, {"PCUSStanNa", type date},
				            {"PierwszyTermin", type date}, {"PrognozaNFZDni", Int64.Type}
				        },
				        "en-US"
				    ),
				    Flagi = Table.TransformColumns(
				        Typy,
				        {
				            {"WieleMiejsc", each _ = "Y", type logical},
				            {"WCeR", each _ = "Y", type logical},
				            {"Znieczulenie", each if _ = "Y" then "Tak" else if _ = "N" then "Nie" else null, type text},
				            {"OkresStatystyk", each try #date(Number.From(Text.Start(_, 4)), Number.From(Text.End(_, 2)), 1) otherwise null, type date}
				        }
				    ),
				    SredniWazny = Table.AddColumn(
				        Flagi, "SredniCzasDniWazny",
				        each if [SredniCzasDni] = null or ([SredniCzasDni] = 0 and ([Skresleni] = null or [Skresleni] = 0)) then null else [SredniCzasDni],
				        Int64.Type
				    ),
				    Sredni = Table.RenameColumns(Table.RemoveColumns(SredniWazny, {"SredniCzasDni"}), {{"SredniCzasDniWazny", "SredniCzasDni"}}),
				    Rozladowanie = Table.AddColumn(
				        Sredni, "CzasRozladowaniaDni",
				        each if [Skresleni] <> null and [Skresleni] > 0 and [Oczekujacy] <> null then Number.Round([Oczekujacy] / [Skresleni] * 30, 1) else null,
				        type number
				    ),
				    BrakPCUS = Table.AddColumn(Rozladowanie, "BrakPCUS", each [PCUSDni] = null, type logical),
				    Nieaktualne = Table.AddColumn(
				        BrakPCUS, "DaneNieaktualne",
				        each
				            (if [PCUSStanNa] <> null then Duration.Days([DataSnapshotu] - [PCUSStanNa]) > 45 else false)
				            or (if [OkresStatystyk] <> null then [OkresStatystyk] < Date.AddMonths(Date.StartOfMonth([DataSnapshotu]), -2) else false),
				        type logical
				    ),
				    Przedzialy = {"0–7", "8–14", "15–30", "31–60", "61–90", "91–180", "181–365", "> 365", "brak PCUŚ"},
				    Przedzial = Table.AddColumn(
				        Nieaktualne, "PrzedzialPCUS",
				        each
				            if [PCUSDni] = null then "brak PCUŚ"
				            else if [PCUSDni] <= 7 then "0–7"
				            else if [PCUSDni] <= 14 then "8–14"
				            else if [PCUSDni] <= 30 then "15–30"
				            else if [PCUSDni] <= 60 then "31–60"
				            else if [PCUSDni] <= 90 then "61–90"
				            else if [PCUSDni] <= 180 then "91–180"
				            else if [PCUSDni] <= 365 then "181–365"
				            else "> 365",
				        type text
				    ),
				    PrzedzialSort = Table.AddColumn(Przedzial, "PrzedzialPCUSSort", each List.PositionOf(Przedzialy, [PrzedzialPCUS]) + 1, Int64.Type),
				    Aktywna = Table.AddColumn(
				        PrzedzialSort, "KolejkaAktywna",
				        each not ([Oczekujacy] = 0 and ([Skresleni] = null or [Skresleni] = 0)),
				        type logical
				    ),
				    Wynik = Table.SelectColumns(
				        Aktywna,
				        {"DataSnapshotu", "MiejsceKey", "SwiadczenieKey", "Przypadek", "Oddzial", "WieleMiejsc", "WCeR",
				         "Znieczulenie", "PrzedzialWieku", "Oczekujacy", "Skresleni", "SredniCzasDni", "OkresStatystyk",
				         "PCUS", "PCUSDni", "PCUSStanNa", "PierwszyTermin", "PrognozaNFZDni", "CzasRozladowaniaDni",
				         "BrakPCUS", "DaneNieaktualne", "PrzedzialPCUS", "PrzedzialPCUSSort", "KolejkaAktywna"}
				    )
				in
				    Wynik

	annotation PBI_ResultType = Table

