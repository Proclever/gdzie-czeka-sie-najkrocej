	column 'Ostatnio w danych'
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: 88a40739-d135-580c-8060-7bb7db33f8a4
		summarizeBy: none
		sourceColumn: Ostatnio w danych

		annotation SummarizationSetBy = Automatic

	partition DimPlacowka = m
		mode: import
		queryGroup: Dane
		source =
				let
				    Prefiks = GitHubWlasciciel & "/" & GitHubRepozytorium & "/" & GitHubGalaz & "/",
				    Pobierz = (sciezka as text) as nullable binary =>
				        let
				            Odpowiedz = Web.Contents(
				                "https://raw.githubusercontent.com",
				                [RelativePath = Prefiks & sciezka, ManualStatusHandling = {404}]
				            ),
				            Status = Value.Metadata(Odpowiedz)[Response.Status],
				            Tresc =
				                if Status = 404 then null
				                else if Text.EndsWith(sciezka, ".gz") then Binary.Decompress(Odpowiedz, Compression.GZip)
				                else Odpowiedz
				        in
				            Tresc,
				    CzytajCsv = (sciezka as text, kolumny as list) as table =>
				        let
				            Plik = Pobierz(sciezka),
				            Surowa =
				                if Plik = null then #table(kolumny, {})
				                else Table.PromoteHeaders(
				                    Csv.Document(Plik, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]
				                )
				        in
				            Table.SelectColumns(Surowa, kolumny, MissingField.UseNull),
				    Kolumny = {
				        "MiejsceKey", "Swiadczeniodawca", "KodSwiadczeniodawcy", "Miejsce", "Adres", "Miejscowosc", "Telefon",
				        "TerytMiejsca", "TerytPowiat", "Oddzial", "Toaleta", "Podjazd", "Parking", "Winda", "Klimatyzacja",
				        "DrzwiAutomatyczne", "WozkiInwalidzkie", "Korytarze", "KomunikacjaPubliczna", "Szerokosc", "Dlugosc",
				        "ZrodloLokalizacji", "PierwszyRaz", "OstatnioWidziane"
				    },
				    Miejsca = Table.Distinct(CzytajCsv("data/nfz/miejsca.csv.gz", Kolumny), {"MiejsceKey"}),
				    Powiaty = CzytajCsv("data/geo/powiaty.csv", {"TerytPowiat", "Powiat", "Wojewodztwo"}),
				    ZPowiatem = Table.ExpandTableColumn(
				        Table.NestedJoin(Miejsca, {"TerytPowiat"}, Powiaty, {"TerytPowiat"}, "P", JoinKind.LeftOuter),
				        "P", {"Powiat", "Wojewodztwo"}
				    ),
				    BezPustych = Table.ReplaceValue(
				        ZPowiatem, "", null, Replacer.ReplaceValue,
				        {"Szerokosc", "Dlugosc", "PierwszyRaz", "OstatnioWidziane", "TerytPowiat", "Telefon", "KomunikacjaPubliczna"}
				    ),
				    Typy = Table.TransformColumnTypes(
				        BezPustych,
				        {{"Szerokosc", type number}, {"Dlugosc", type number}, {"PierwszyRaz", type date}, {"OstatnioWidziane", type date}},
				        "en-US"
				    ),
				    Udogodnienia = {"Toaleta", "Podjazd", "Parking", "Winda", "Klimatyzacja", "DrzwiAutomatyczne", "WozkiInwalidzkie", "Korytarze"},
				    TakNie = Table.TransformColumns(
				        Typy,
				        List.Transform(Udogodnienia, (k) => {k, each if _ = "Y" then "Tak" else if _ = "N" then "Nie" else "brak danych", type text})
				    ),
				    Miejscowosc = Table.TransformColumns(TakNie, {{"Miejscowosc", each if _ = null then null else Text.Proper(_), type text}}),
				    Placowka = Table.AddColumn(
				        Miejscowosc, "Placowka",
				        each Text.Combine(List.Select({[Swiadczeniodawca], [Miejsce]}, each _ <> null and _ <> ""), " – "),
				        type text
				    ),
				    Adres = Table.AddColumn(
				        Placowka, "AdresPelny",
				        each Text.Combine(List.Select({[Adres], [Miejscowosc]}, each _ <> null and _ <> ""), ", "),
				        type text
				    ),
				    Dokladna = Table.AddColumn(
				        Adres, "LokalizacjaDokladna",
				        each [ZrodloLokalizacji] <> null and Text.StartsWith([ZrodloLokalizacji], "NFZ"),
				        type logical
				    ),
				    BezPowiatu = Table.ReplaceValue(Dokladna, null, "nieustalony", Replacer.ReplaceValue, {"Powiat", "Wojewodztwo"}),
				    Wynik = Table.RenameColumns(
				        BezPowiatu,
				        {
				            {"Swiadczeniodawca", "Świadczeniodawca"}, {"KodSwiadczeniodawcy", "Kod świadczeniodawcy"},
				            {"Miejscowosc", "Miejscowość"}, {"Wojewodztwo", "Województwo"}, {"Placowka", "Placówka"},
				            {"AdresPelny", "Adres pełny"}, {"DrzwiAutomatyczne", "Drzwi automatyczne"},
				            {"WozkiInwalidzkie", "Wózki inwalidzkie"}, {"KomunikacjaPubliczna", "Komunikacja publiczna"},
				            {"Szerokosc", "Szerokość"}, {"Dlugosc", "Długość"}, {"ZrodloLokalizacji", "Źródło lokalizacji"},
				            {"PierwszyRaz", "Pierwszy raz w danych"}, {"OstatnioWidziane", "Ostatnio w danych"}
				        }
				    )
				in
				    Wynik

	annotation PBI_ResultType = Table
