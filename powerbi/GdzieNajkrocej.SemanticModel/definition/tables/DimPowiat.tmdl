	column 'Udział 65+'
		dataType: double
		formatString: 0.0%
		lineageTag: 364b7dc0-1d5e-54be-a3d4-e14730722428
		summarizeBy: none
		sourceColumn: Udział 65+

		annotation SummarizationSetBy = Automatic

	partition DimPowiat = m
		mode: import
		queryGroup: Dane
		source =
				let
				    Prefiks = GitHubWlasciciel & "/" & GitHubRepozytorium & "/" & GitHubGalaz & "/",
				    Pobierz = (sciezka as text) as nullable binary =>
				        let
				            Odpowiedz = Web.Contents(
				                "https://raw.githubusercontent.com",
				                [RelativePath = Prefiks & sciezka, ManualStatusHandling = {404}]
				            ),
				            Status = Value.Metadata(Odpowiedz)[Response.Status],
				            Tresc =
				                if Status = 404 then null
				                else if Text.EndsWith(sciezka, ".gz") then Binary.Decompress(Odpowiedz, Compression.GZip)
				                else Odpowiedz
				        in
				            Tresc,
				    CzytajCsv = (sciezka as text, kolumny as list) as table =>
				        let
				            Plik = Pobierz(sciezka),
				            Surowa =
				                if Plik = null then #table(kolumny, {})
				                else Table.PromoteHeaders(
				                    Csv.Document(Plik, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]
				                )
				        in
				            Table.SelectColumns(Surowa, kolumny, MissingField.UseNull),
				    Powiaty = CzytajCsv(
				        "data/geo/powiaty.csv",
				        {"TerytPowiat", "NazwaPowiatu", "Powiat", "Wojewodztwo", "TypPowiatu", "KluczMapy", "SzerokoscSrodka", "DlugoscSrodka"}
				    ),
				    Gus = CzytajCsv(
				        "data/gus/powiaty_gus.csv",
				        {"TerytPowiat", "Ludnosc", "Ludnosc65plus", "RokLudnosci", "Wynagrodzenie", "WynagrodzenieIndeksPL100", "RokWynagrodzenia"}
				    ),
				    Polaczone = Table.ExpandTableColumn(
				        Table.NestedJoin(Powiaty, {"TerytPowiat"}, Gus, {"TerytPowiat"}, "G", JoinKind.LeftOuter),
				        "G", {"Ludnosc", "Ludnosc65plus", "RokLudnosci", "Wynagrodzenie", "WynagrodzenieIndeksPL100", "RokWynagrodzenia"}
				    ),
				    BezPustych = Table.ReplaceValue(
				        Polaczone, "", null, Replacer.ReplaceValue,
				        {"Ludnosc", "Ludnosc65plus", "RokLudnosci", "Wynagrodzenie", "WynagrodzenieIndeksPL100", "RokWynagrodzenia", "SzerokoscSrodka", "DlugoscSrodka"}
				    ),
				    Typy = Table.TransformColumnTypes(
				        BezPustych,
				        {
				            {"Ludnosc", Int64.Type}, {"Ludnosc65plus", Int64.Type}, {"RokLudnosci", Int64.Type},
				            {"Wynagrodzenie", type number}, {"WynagrodzenieIndeksPL100", type number}, {"RokWynagrodzenia", Int64.Type},
				            {"SzerokoscSrodka", type number}, {"DlugoscSrodka", type number}
				        },
				        "en-US"
				    ),
				    Udzial = Table.AddColumn(
				        Typy, "Udzial65plus",
				        each if [Ludnosc] = null or [Ludnosc] = 0 or [Ludnosc65plus] = null then null else [Ludnosc65plus] / [Ludnosc],
				        type number
				    ),
				    Wynik = Table.RenameColumns(
				        Udzial,
				        {
				            {"NazwaPowiatu", "Nazwa powiatu"}, {"Wojewodztwo", "Województwo"}, {"TypPowiatu", "Typ powiatu"},
				            {"Ludnosc", "Ludność"}, {"Ludnosc65plus", "Ludność 65+"}, {"RokLudnosci", "Rok danych o ludności"},
				            {"Wynagrodzenie", "Przeciętne wynagrodzenie"}, {"WynagrodzenieIndeksPL100", "Wynagrodzenie – indeks PL 100"},
				            {"RokWynagrodzenia", "Rok danych o wynagrodzeniach"}, {"Udzial65plus", "Udział 65+"}
				        }
				    )
				in
				    Wynik

	annotation PBI_ResultType = Exception

