/// Wszystkie 380 powiatów (PRG) z danymi GUS BDL – również te bez placówek.
table DimPowiat
	lineageTag: c5557427-d5da-5eaf-ae76-c646074951e7

	/// Kod TERYT powiatu (4 znaki).
	column TerytPowiat
		dataType: string
		isKey
		lineageTag: 668a0bd3-d354-5d9b-9a09-1ad938887873
		summarizeBy: none
		sourceColumn: TerytPowiat

		annotation SummarizationSetBy = Automatic

